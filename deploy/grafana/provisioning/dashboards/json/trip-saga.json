    {"type":"timeseries","title":"Active Saga by step","id":1,"gridPos":{"h":8,"w":12,"x":0,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum by (step) ({__name__=~\"saga_active(_sagas)?\"})","legendFormat":"{{step}}","refId":"A"}]},
