    {"type":"timeseries","title":"Trip lifecycle decisions","id":3,"gridPos":{"h":8,"w":8,"x":0,"y":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(rate({__name__=~\"trip_created(_trips)?_total\"}[5m]))","legendFormat":"created","refId":"A"},{"expr":"sum(rate({__name__=~\"trip_cancelled(_trips)?_total\"}[5m]))","legendFormat":"cancelled","refId":"B"}]},
