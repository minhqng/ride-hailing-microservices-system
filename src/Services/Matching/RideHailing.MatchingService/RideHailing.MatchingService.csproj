<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../BuildingBlocks/RideHailing.Observability/RideHailing.Observability.csproj" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the Lua function source with the service; loader reads it at startup. -->
    <Content Include="Infrastructure\RedisProjection\*.lua" CopyToOutputDirectory="PreserveNewest" />
    <!-- Ship migration scripts; startup EnsureTables applies them in order. -->
    <Content Include="Infrastructure\Persistence\Migrations\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
