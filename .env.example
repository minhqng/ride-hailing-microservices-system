# Local-development placeholders only. Never commit real secrets.
# Copy to .env (gitignored): cp .env.example .env
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_pw
POSTGRES_DB=postgres
IDENTITY_DB_PASSWORD=identity_dev_pw
DRIVER_DB_PASSWORD=driver_dev_pw
TRIP_DB_PASSWORD=trip_dev_pw
MATCHING_DB_PASSWORD=matching_dev_pw
PAYMENT_DB_PASSWORD=payment_dev_pw
NOTIFICATION_DB_PASSWORD=notification_dev_pw
RABBITMQ_USER=ride_app
RABBITMQ_PASSWORD=ride_dev_pw
ASPNETCORE_ENVIRONMENT=Development
PAYMENT_INSTANCE_ID=payment-local
NOTIFICATION_INSTANCE_ID=notification-local
# Apply Trip migrations before enabling the W8 broker integration.
TRIP_MESSAGING_ENABLED=false
# Local/CI compose auto-applies Trip EF migrations at startup so
# /health/ready (zero pending migrations) passes on fresh volumes.
# Production must set false and apply migrations via an external job.
TRIP_AUTO_MIGRATE=true
